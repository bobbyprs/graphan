# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Application metadata database (PostgreSQL)
DATABASE_URL=postgresql://graphan:graphan@localhost:5432/graphan?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# 32-byte key, base64 encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_xxxxxxxxxxx=

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Query guard rails
QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_MS=30000

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Graphan Alerts <alerts@example.com>"
APP_PUBLIC_URL=http://localhost:5173

# Signed embedding into other apps (see docs/EMBEDDING.md). Empty = disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EMBED_SECRET=
EMBED_SESSION_TTL=8h

# Seed admin
SEED_ADMIN_EMAIL=admin@graphan.local
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Web (Vite) ----------
VITE_API_URL=http://localhost:4000
